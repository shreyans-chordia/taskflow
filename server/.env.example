# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Local MongoDB (docker compose up -d mongo) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/taskflow

# Browser origins allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:5173

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# lax: web app and API on the same site. none: different domains (production + HTTPS only)
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (0 locally, usually 1 on Render/Railway)
TRUST_PROXY=0
LOG_LEVEL=info
