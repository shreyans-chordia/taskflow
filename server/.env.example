# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Local MongoDB (docker compose up -d mongo) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/taskflow

# Browser origins allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:5173

# At least 32 random characters. The API refuses to start with the placeholder below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# lax: web app and API on the same site. none: different domains (production + HTTPS only)
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (0 locally, usually 1 on Render/Railway)
TRUST_PROXY=0
LOG_LEVEL=info

# ---------- Email: sign-in codes and password reset ----------
# console = codes are printed in this terminal (fine for local development, refused in production)
# smtp    = real email. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#           SMTP_PASS=a 16-letter App Password (Google Account > Security > 2-Step Verification > App passwords)
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TaskFlow <no-reply@taskflow.local>
# Minutes a code stays valid (2-30)
OTP_TTL_MIN=10
